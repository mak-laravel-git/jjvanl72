APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Live database (use real values locally in .env — never commit secrets)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=default
# DB_USERNAME=mysql
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=laravel-session

BROADCAST_CONNECTION=log

# Reverb — publish to the standalone Coolify Reverb container (Pusher protocol).
# REVERB_APP_* MUST match jjvan_reverb_server exactly.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public WS host (Coolify Traefik). Prefer :443 https over internal Docker DNS.
REVERB_HOST=ws.jjvanl.maktechlaravel.cloud
REVERB_PORT=443
REVERB_SCHEME=https

# HTTP CORS (config/cors.php): FULL origin URLs with scheme, no path/slash.
# Wrong: jjvanl.maktechlaravel.cloud  Right: https://jjvanl.maktechlaravel.cloud
# Do NOT confuse with REVERB_ALLOWED_ORIGINS on the Reverb server (bare hostnames).
FRONTEND_URL=https://jjvanl.maktechlaravel.cloud
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1

# Echo client (Vite). Same host/port/scheme as REVERB_* public values.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=laravel-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PREFIX=laravel-database-

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_ERROR_BOUNDARY_DEBUG=

# Firebase Web (browser push + service worker). Also synced to storage/app/firebase-web-config.json
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

TELESCOPE_ENABLED=true

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_QUEUE_CONNECTION=redis
SCOUT_QUEUE_NAME=scout
# Coolify Meilisearch service URL (separate container from the app)
MEILISEARCH_HOST=https://meilisearch.jjvanl.maktechlaravel.cloud
MEILISEARCH_KEY=
